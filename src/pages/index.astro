---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import HubCard from '../components/HubCard.astro';
import GuideCard from '../components/GuideCard.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import ProgressTracker from '../components/ProgressTracker.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from '../lib/config';

const title = "Stuck in Resident Evil Requiem? Puzzle Solutions, Boss Help & Walkthrough | Requiem Guide";
const description = "Problem-solving guide for Resident Evil Requiem: exact puzzle codes and locations, boss weaknesses and strategies, key item locations, and chapter-by-chapter walkthrough context.";

const guides = await getCollection('guide');
const walkthroughChapters = guides
  .filter((g) => g.data.category === 'walkthrough')
  .sort((a, b) => (b.data.chapter || 0) - (a.data.chapter || 0));

const latestWalkthroughs = walkthroughChapters.slice(0, 3);

const puzzles = await getCollection('puzzle');
const latestPuzzles = puzzles.slice(0, 6);

const bosses = await getCollection('boss');
const latestBosses = bosses.slice(0, 3);

const progressChapters = walkthroughChapters
  .sort((a, b) => (a.data.chapter || 0) - (b.data.chapter || 0))
  .map((g) => ({
    slug: g.slug,
    title: g.data.title,
    href: `/walkthrough/${g.slug}`,
  }));

const problemEntries = [
  {
    icon: 'lucide:puzzle',
    label: "I'm stuck on a puzzle",
    detail: 'Quartz boxes, safe codes, symbol sequences — exact answers.',
    href: '/puzzles',
  },
  {
    icon: 'lucide:lock',
    label: "I can't open a door",
    detail: 'What each lock needs and where to find it.',
    href: '/puzzles',
  },
  {
    icon: 'lucide:box',
    label: "I can't find an item",
    detail: 'Key items, where they spawn, and what they unlock.',
    href: '/items',
  },
  {
    icon: 'lucide:skull',
    label: "I can't beat a boss",
    detail: 'Weaknesses, patterns, and what to bring.',
    href: '/bosses',
  },
  {
    icon: 'lucide:map',
    label: "I don't know where to go",
    detail: 'Chapter-by-chapter route with objectives.',
    href: '/walkthrough',
  },
  {
    icon: 'lucide:film',
    label: 'I want to know what happens',
    detail: 'Story context, endings, and choice consequences.',
    href: '/story/endings',
  },
];

const keywords = [
  'resident evil requiem guide',
  'resident evil requiem puzzle solutions',
  'resident evil requiem walkthrough',
  'resident evil requiem boss guide',
  'resident evil requiem item locations',
];

const faqs = [
  {
    question: 'How do I solve the Quartz puzzles in Resident Evil Requiem?',
    answer: 'Each Quartz puzzle box has an exact symbol sequence. Our puzzle pages list the code, the box location, the required item, and what the reward unlocks — starting with the Sun Quartz Puzzle Box solution.',
  },
  {
    question: 'Where do I find key items when I am missing one?',
    answer: 'The item guides list each key item with its exact location, any prerequisite, and what it unlocks next, so you can get back on route quickly.',
  },
  {
    question: 'How do I beat bosses that are not taking damage?',
    answer: 'Most bosses have a specific weak point that triggers staggers. Each boss guide covers the weakness, attack patterns, and a recommended loadout.',
  },
  {
    question: 'What should I do after finishing a chapter?',
    answer: 'Chapter walkthroughs list objectives, missable items, puzzle checkpoints, and the boss encounter, with a direct link to the next chapter.',
  },
];
---

<MainLayout
  title={title}
  description={description}
  keywords={keywords}
  currentPath="/"
  type="website"
  image="/images/requiem_survival_guide_homepage_024.jpg"
>
  <!-- Hero: problem-first -->
  <section class="relative overflow-hidden border-b border-horror-border min-h-[80vh] flex items-center">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/requiem_survival_guide_homepage_024.jpg"
        alt="Resident Evil Requiem atmospheric gothic mansion"
        width="512"
        height="286"
        loading="eager"
        fetchpriority="high"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-horror-bg/60"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-horror-bg via-horror-bg/80 to-horror-bg/40"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-horror-bg via-transparent to-horror-bg/30"></div>

      <div class="absolute inset-0 opacity-10 pointer-events-none">
        <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-horror-red rounded-full blur-[120px]"></div>
        <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-horror-red/60 rounded-full blur-[140px]"></div>
      </div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-24 lg:py-28 w-full">
      <div class="max-w-3xl mb-10 sm:mb-12">
        <div class="flex flex-wrap items-center gap-2 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-horror-green/15 text-horror-green border border-horror-green/30 text-sm font-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            Updated September 2026
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-horror-red/15 text-horror-red border border-horror-red/30 text-sm font-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
            Spoiler-free sections
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-horror-text leading-[1.1] mb-6">
          Stuck in Resident Evil Requiem?
          <br />
          <span class="text-horror-red">Find the exact answer.</span>
        </h1>
        <p class="text-lg sm:text-xl lg:text-2xl text-horror-text-secondary mb-4 max-w-2xl">
          Puzzle codes, item locations, boss weaknesses, and where to go next — verified answers you can act on immediately, without digging through a full walkthrough.
        </p>
      </div>

      <!-- Problem entry points -->
      <div class="mb-4">
        <h2 class="text-sm font-bold text-horror-text uppercase tracking-widest mb-4 flex items-center gap-2">
          <Icon name="lucide:circle-help" class="w-4 h-4 text-horror-red" />
          What are you stuck on?
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
          {problemEntries.map((entry) => (
            <a
              href={entry.href}
              class="group rounded-xl border border-horror-border bg-horror-surface/80 backdrop-blur-sm p-4 sm:p-5 hover:border-horror-red/60 hover:bg-horror-surface transition-colors"
            >
              <div class="flex items-center gap-2 mb-2">
                <Icon name={entry.icon} class="w-5 h-5 text-horror-red flex-shrink-0" />
                <span class="font-bold text-horror-text text-sm sm:text-base leading-tight">{entry.label}</span>
              </div>
              <p class="text-xs sm:text-sm text-horror-text-secondary leading-relaxed">{entry.detail}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Puzzle Solutions: the core problem pages -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-horror-text mb-3">Puzzle Solutions</h2>
        <p class="text-horror-text-secondary max-w-2xl">
          Exact codes, locations, required items, and rewards — verified against multiple published guides.
        </p>
      </div>
      <a href="/puzzles" class="inline-flex items-center gap-2 self-start px-4 py-2 rounded-lg border border-horror-border text-horror-text font-medium hover:border-horror-red hover:text-horror-red transition-colors">
        All puzzle solutions
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {latestPuzzles.map((puzzle) => (
        <GuideCard
          href={`/puzzles/${puzzle.slug}`}
          title={puzzle.data.title}
          category="Puzzle"
          description={puzzle.data.description || `Solution for ${puzzle.data.title}`}
          image={puzzle.data.image || '/images/requiem_survival_guide_homepage_026.jpg'}
        />
      ))}
    </div>
  </section>

  <!-- Walkthrough: context, not the main product -->
  <section class="border-y border-horror-border bg-horror-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-horror-text mb-3">Chapter Walkthrough</h2>
          <p class="text-horror-text-secondary max-w-2xl">
            Route context for when you are lost: objectives, missables, and puzzle checkpoints per chapter.
          </p>
        </div>
        <a href="/walkthrough" class="inline-flex items-center gap-2 self-start px-4 py-2 rounded-lg border border-horror-border text-horror-text font-medium hover:border-horror-red hover:text-horror-red transition-colors">
          All chapters
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
        <div class="lg:col-span-2 rounded-xl border border-horror-border bg-horror-bg p-6">
          <h3 class="font-bold text-horror-text mb-2">The route at a glance</h3>
          <p class="text-sm text-horror-text-secondary mb-4">
            Eight chapters from Wrenwood to the ARK. Chapter numbers are a guide convention — the game itself has no chapter select.
          </p>
          <ol class="grid sm:grid-cols-2 gap-x-6 gap-y-1.5 text-sm text-horror-text-secondary list-decimal list-inside">
            <li>Wrenwood Hotel &amp; Elbridge</li>
            <li>Rhodes Hill 1 — The Girl</li>
            <li>Rhodes Hill 2 — the Quartz pieces</li>
            <li>Rhodes Hill 3 — the Basement, Emily</li>
            <li>Rhodes Hill 4 — Helipad &amp; Water Treatment Plant</li>
            <li>East Raccoon City — Leon</li>
            <li>Raccoon City Center — RPD &amp; Orphanage</li>
            <li>The ARK — Archives &amp; final boss</li>
          </ol>
        </div>

        <div class="lg:col-span-1">
          <a href="/walkthrough" class="group flex flex-col h-full rounded-xl border border-horror-border bg-horror-bg p-6 hover:border-horror-red/50 transition-all">
            <h3 class="font-bold text-horror-text group-hover:text-horror-red transition-colors mb-2">Full chapter overview</h3>
            <p class="text-sm text-horror-text-secondary mb-4">
              Spoiler-light objectives, missables, and puzzle checkpoints per chapter — with links into the puzzle and boss guides.
            </p>
            <span class="mt-auto inline-flex items-center gap-2 text-horror-red font-medium text-sm">
              Open the walkthrough
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Boss Guides -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-horror-text mb-3">Boss Guides</h2>
        <p class="text-horror-text-secondary max-w-2xl">
          Weaknesses, attack patterns, and what to bring for every boss encounter.
        </p>
      </div>
      <a href="/bosses" class="inline-flex items-center gap-2 self-start px-4 py-2 rounded-lg border border-horror-border text-horror-text font-medium hover:border-horror-red hover:text-horror-red transition-colors">
        All bosses
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {latestBosses.map((boss) => (
        <GuideCard
          href={`/bosses/${boss.slug}`}
          title={boss.data.title}
          category="Boss"
          description={boss.data.description || `How to beat ${boss.data.title}`}
          image={boss.data.image || '/images/requiem_survival_guide_homepage_027.jpg'}
          variant="boss"
        />
      ))}
    </div>
  </section>

  <!-- Reference hubs (demoted) -->
  <section class="border-y border-horror-border bg-horror-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <div class="mb-8 sm:mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-horror-text mb-3">Reference</h2>
        <p class="text-horror-text-secondary max-w-3xl">
          Weapons, enemies, items, and characters — supporting reference for the problem pages above.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <HubCard
          href="/weapons"
          title="Weapons"
          description="Stats, locations, upgrades."
          icon="lucide:crosshair"
          image="/images/requiem_survival_guide_weapons_database_058.jpg"
        />
        <HubCard
          href="/story/endings"
          title="Story & Endings"
          description="The route, the final choice, both endings."
          icon="lucide:book-open"
          image="/images/requiem_survival_guide_ending_explained_010.jpg"
        />
        <HubCard
          href="/items"
          title="Items"
          description="Key items and collectibles."
          icon="lucide:box"
          image="/images/item_east-wing-key.jpg"
        />
        <HubCard
          href="/characters"
          title="Characters"
          description="Profiles and story roles."
          icon="lucide:users"
          image="/images/requiem_survival_guide_grace_ashcroft_profile_017.jpg"
        />
      </div>
    </div>
  </section>

  <!-- FAQ: kept minimal, only guide-usage questions -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="mb-8 sm:mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold text-horror-text mb-3">Frequently Asked Questions</h2>
      <p class="text-horror-text-secondary">
        Quick answers about getting unstuck in Resident Evil Requiem.
      </p>
    </div>

    <FAQAccordion faqs={faqs} />
  </section>

  <!-- Final CTA -->
  <section class="border-y border-horror-border bg-horror-surface">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 text-center">
      <div class="inline-flex items-center justify-center p-3 rounded-full bg-horror-red/10 text-horror-red mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
        </svg>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-horror-text mb-4">Found something wrong or missing?</h2>
      <p class="text-horror-text-secondary mb-8 max-w-xl mx-auto">
        Corrections matter more than new pages here — every answer on this site is fact-checked. Send us what you found.
      </p>
      <a
        href="mailto:hello@requiemguide.com"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-horror-red text-white font-semibold rounded-xl hover:bg-horror-red-light transition-colors"
      >
        Contact Us
      </a>
    </div>
  </section>
</MainLayout>
