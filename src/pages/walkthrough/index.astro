---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VerificationBlock from '../../components/VerificationBlock.astro';
import { Icon } from 'astro-icon/components';

const title = 'Resident Evil Requiem Walkthrough - Chapter Overview | Requiem Guide';
const description = 'Resident Evil Requiem chapter overview: story structure from Wrenwood Hotel to the ARK, with links to verified puzzle solutions and boss guides for each stretch of the game.';

// Chapter structure per Rock Paper Shotgun's walkthrough (post-release).
// Note: RE Requiem has no in-game chapter select; chapter numbers are a guide convention.
const chapters = [
  {
    num: 1,
    name: 'Wrenwood Hotel & Elbridge',
    area: 'Opening — Grace Ashcroft',
    detail: 'The investigation begins at the Wrenwood Hotel before the trail leads to Rhodes Hill.',
  },
  {
    num: 2,
    name: 'Rhodes Hill Care Center — First Exploration',
    area: 'The Girl encounters',
    detail: 'First exploration of the Care Center. The Girl (Shadow Ghost) stalks these corridors.',
    boss: { slug: 'shadow-ghost', label: 'The Girl (Shadow Ghost)' },
  },
  {
    num: 3,
    name: 'Rhodes Hill — The Quartz Pieces',
    area: 'Care Center East & West Wings',
    detail: 'Find the Moon, Sun, and Star Quartz puzzle boxes and open the Central Hall mechanism.',
    links: [
      { href: '/puzzles/moon-quartz-box', label: 'Moon Quartz Box' },
      { href: '/puzzles/sun-quartz-box', label: 'Sun Quartz Box' },
      { href: '/puzzles/star-quartz-box', label: 'Star Quartz Box' },
      { href: '/puzzles/central-hall-quartz', label: 'Central Hall Mechanism' },
      { href: '/puzzles/safe-codes', label: 'All Safe Codes' },
      { href: '/puzzles/blood-analyzer', label: 'Blood Analyzer' },
    ],
  },
  {
    num: 4,
    name: 'Rhodes Hill — Basement',
    area: 'Emily rescue sequence',
    detail: 'The route continues below the Care Center, including the sequence where Emily is rescued.',
  },
  {
    num: 5,
    name: 'Rhodes Hill — Helipad & Water Treatment Plant',
    area: 'Grace',
    detail: 'The helicopter escape goes wrong; the Water Treatment Plant holds the last stretch of the Care Center.',
    boss: { slug: 'emily-transformed', label: 'Emily (Transformed)' },
  },
  {
    num: 6,
    name: 'East Raccoon City',
    area: 'Leon S. Kennedy',
    detail: 'Leon\'s campaign through the ruined city, including the giant spider boss.',
    boss: { slug: 'titan-spinner', label: 'Titan Spinner' },
  },
  {
    num: 7,
    name: 'Raccoon City Center',
    area: 'RPD & Orphanage',
    detail: 'The RPD and Orphanage sections, including Tyrant T-501 pursuit encounters.',
  },
  {
    num: 8,
    name: 'The ARK',
    area: 'Finale',
    detail: 'Archives, Bioweapon Repository, and the final confrontation. Your last choice decides the ending.',
    link: { href: '/story/endings', label: 'Endings explained (spoilers)' },
  },
];

const keywords = [
  'resident evil requiem walkthrough',
  'resident evil requiem chapter guide',
  'resident evil requiem all chapters',
  'resident evil requiem story order',
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://requiemguide.com' },
    { '@type': 'ListItem', position: 2, name: 'Walkthrough', item: 'https://requiemguide.com/walkthrough' },
  ],
};
---

<MainLayout
  title={title}
  description={description}
  keywords={keywords}
  currentPath="/walkthrough"
  extraSchema={[breadcrumbSchema]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={[{ label: 'Walkthrough', href: '/walkthrough' }]} />

    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-horror-text mb-4">
        Resident Evil Requiem Walkthrough
      </h1>
      <p class="text-lg text-horror-text-secondary leading-relaxed">
        Story overview from the Wrenwood Hotel to the ARK finale, with direct links to the verified puzzle solutions and boss guides for each stretch. Use this page to orient yourself, then jump straight to the problem you are stuck on.
      </p>
    </header>

    <div class="rounded-xl border border-horror-border bg-horror-surface p-4 sm:p-5 mb-10 text-sm text-horror-text-secondary leading-relaxed">
      <strong class="text-horror-text">Note on chapters:</strong> Resident Evil Requiem has no in-game chapter select, so chapter numbers are a guide convention. The structure below follows the widely used post-release walkthrough convention.
    </div>

    <ol class="relative border-l border-horror-border ml-3 sm:ml-4 space-y-8 mb-12">
      {chapters.map((ch) => (
        <li class="relative pl-8 sm:pl-10">
          <span class="absolute -left-4 sm:-left-5 top-0 w-8 h-8 rounded-full bg-horror-red/10 border border-horror-red/40 text-horror-red font-black flex items-center justify-center text-sm">
            {ch.num}
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-horror-text mb-1" id={`ch-${ch.num}`}>
            Chapter {ch.num}: {ch.name}
          </h2>
          <p class="text-sm text-horror-text-muted mb-2">{ch.area}</p>
          <p class="text-horror-text-secondary leading-relaxed mb-3">{ch.detail}</p>
          {ch.boss && (
            <a href={`/bosses/${ch.boss.slug}`} class="inline-flex items-center gap-1.5 text-sm font-semibold text-horror-red hover:underline mb-2">
              <Icon name="lucide:skull" class="w-4 h-4" />
              Boss: {ch.boss.label}
            </a>
          )}
          {ch.links && (
            <div class="flex flex-wrap gap-2 mt-1">
              {ch.links.map((l) => (
                <a href={l.href} class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-horror-border text-xs sm:text-sm text-horror-text-secondary hover:border-horror-red/60 hover:text-horror-text transition-colors">
                  <Icon name="lucide:puzzle" class="w-3.5 h-3.5 text-horror-red" />
                  {l.label}
                </a>
              ))}
            </div>
          )}
          {ch.link && (
            <a href={ch.link.href} class="inline-flex items-center gap-1.5 text-sm font-semibold text-horror-red hover:underline">
              {ch.link.label}
              <Icon name="lucide:arrow-right" class="w-4 h-4" />
            </a>
          )}
        </li>
      ))}
    </ol>

    <VerificationBlock status="corroborated" lastChecked="September 2026" />
  </div>
</MainLayout>
