---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VerificationBlock from '../../components/VerificationBlock.astro';
import { Icon } from 'astro-icon/components';

const title = 'Resident Evil Requiem Enemies - Full Roster | Requiem Guide';
const description = 'The complete Resident Evil Requiem enemy roster: every infected, mutated creature, and bioweapon you will face, grouped by area. Boss encounters link to their dedicated guides.';

// Roster cross-checked against Evil Resource's complete enemy list and GameSpot's enemy coverage (post-release).
const groups = [
  {
    name: 'Rhodes Hill Infected',
    note: 'The staff and patients of the Care Center.',
    enemies: [
      'Wrenwood Zombie',
      'Zombie Doctor',
      'Zombie Patient',
      'Zombie Staff Member',
      'Zombie Blind Patient',
      'Zombie Cleaner',
      'Zombie Singer',
      'Chef Zombie (optional boss)',
    ],
  },
  {
    name: 'Mutated Creatures',
    note: 'Area bosses and recurring threats. Boss encounters have dedicated guides.',
    enemies: [
      'The Girl (Shadow Ghost) — boss guide available',
      'Blister Head',
      'Blister Borne — boss guide available',
      'Chunk — boss guide available',
      'Small Spider',
      'Titan Spinner — boss guide available',
    ],
    links: [
      { href: '/bosses/shadow-ghost', label: 'The Girl guide' },
      { href: '/bosses/blister-borne', label: 'Blister Borne guide' },
      { href: '/bosses/chunk', label: 'Chunk guide' },
      { href: '/bosses/titan-spinner', label: 'Titan Spinner guide' },
    ],
  },
  {
    name: 'Raccoon City Threats',
    note: 'Leon\'s campaign through the ruins of Raccoon City.',
    enemies: [
      'Raccoon City Zombie',
      'Raccoon City BSAA Zombie',
      'Raccoon City Chainsaw Zombie',
      'Garmr',
      'R.P.D. Zombie',
      'The Children',
      'Licker β2',
    ],
  },
  {
    name: 'ARK Bioweapons',
    note: 'The final facility\'s security and specimens.',
    enemies: [
      'ARK Zombie',
      'Elite Guard',
      'Plant 43',
      'Tyrant T-501 (pursuit)',
      'Super Tyrant T-501',
      'The Commander',
    ],
  },
];

const keywords = [
  'resident evil requiem enemies',
  'resident evil requiem enemy list',
  'resident evil requiem all enemies',
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://requiemguide.com' },
    { '@type': 'ListItem', position: 2, name: 'Enemies', item: 'https://requiemguide.com/enemies' },
  ],
};
---

<MainLayout
  title={title}
  description={description}
  keywords={keywords}
  currentPath="/enemies"
  extraSchema={[breadcrumbSchema]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={[{ label: 'Enemies', href: '/enemies' }]} />

    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-horror-text mb-4">
        Resident Evil Requiem Enemies
      </h1>
      <p class="text-lg text-horror-text-secondary leading-relaxed">
        Every hostile you will encounter, grouped by area. Individual threat profiles (weaknesses, tactics) are being added only where we can verify them — the roster itself is confirmed against the complete post-release enemy list.
      </p>
    </header>

    <div class="space-y-8 mb-12">
      {groups.map((group) => (
        <section class="rounded-xl border border-horror-border bg-horror-surface p-5 sm:p-6">
          <h2 class="text-xl sm:text-2xl font-bold text-horror-text mb-1 flex items-center gap-2">
            <Icon name="lucide:bug" class="w-5 h-5 text-horror-red" />
            {group.name}
          </h2>
          <p class="text-sm text-horror-text-muted mb-4">{group.note}</p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            {group.enemies.map((enemy) => (
              <li class="flex items-center gap-2 text-horror-text-secondary text-sm sm:text-base">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-horror-red flex-shrink-0"></span>
                {enemy}
              </li>
            ))}
          </ul>
          {group.links && (
            <div class="flex flex-wrap gap-2 mt-4">
              {group.links.map((l) => (
                <a href={l.href} class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-horror-border text-xs sm:text-sm text-horror-text-secondary hover:border-horror-red/60 hover:text-horror-text transition-colors">
                  <Icon name="lucide:skull" class="w-3.5 h-3.5 text-horror-red" />
                  {l.label}
                </a>
              ))}
            </div>
          )}
        </section>
      ))}
    </div>

    <VerificationBlock status="corroborated" lastChecked="September 2026" />
  </div>
</MainLayout>
