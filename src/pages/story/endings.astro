---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQSection from '../../components/FAQSection.astro';
import VerificationBlock from '../../components/VerificationBlock.astro';
import { Icon } from 'astro-icon/components';

const title = 'Resident Evil Requiem Endings Explained - All Choices & How to Unlock Both';
const description = 'Resident Evil Requiem has exactly two endings, decided by one final choice in the ARK: Release Elpis (the true ending) or Destroy Elpis. Full conditions and outcomes, spoilers inside.';

const keywords = [
  'resident evil requiem endings explained',
  'resident evil requiem true ending',
  'resident evil requiem all endings',
  'resident evil requiem ending choices',
  'resident evil requiem emily ending',
  'resident evil requiem elpis',
  'resident evil requiem hope ending',
  'resident evil requiem story',
];

const endings = [
  {
    name: 'Hope Ending (True Ending)',
    condition: 'At the ARK central console, choose RELEASE Elpis and enter the password HOPE.',
    outcome: 'Elpis — Oswell Spencer\'s antiviral cure — is released. Leon is cured of his T-virus strain, kills the mutated Victor Gideon, Emily is cured and adopted by Grace, and the Raccoon City Syndrome victims are cured.',
  },
  {
    name: 'Destruction Ending (Alternate)',
    condition: 'At the ARK central console, choose DESTROY Elpis (deliberately enter a wrong password).',
    outcome: 'The ARK is destroyed. Leon dies at Zeno\'s hands, and Emily is left trapped in her cocoon.',
  },
];

const faqs = [
  {
    question: 'How many endings does Resident Evil Requiem have?',
    answer: 'Exactly two. They are decided by a single final choice in the ARK: Release Elpis (the true "Hope" ending) or Destroy Elpis (the alternate "Destruction" ending). Nothing earlier in the game branches the ending.',
  },
  {
    question: 'Does Emily\'s fate decide the ending?',
    answer: 'No. Emily\'s injury and mutation during the helicopter crash is a fixed scripted story beat — it happens regardless of your choices. Emily\'s fate differs between the two endings (she is cured and adopted by Grace in the true ending, or left in her cocoon in the alternate), but it does not cause either ending.',
  },
  {
    question: 'How do I unlock the true ending of Resident Evil Requiem?',
    answer: 'At the ARK central console, choose RELEASE Elpis and enter the password HOPE. This is the true/canon "Hope" ending.',
  },
  {
    question: 'Can I see both endings without two full playthroughs?',
    answer: 'Yes. Save the game before Leon takes the elevator to B4 of the Bioweapon Depot, then reload after watching the first ending.',
  },
  {
    question: 'What is Elpis in Resident Evil Requiem?',
    answer: 'Elpis is an antiviral cure created by Oswell E. Spencer — not a character. Releasing or destroying it at the ARK is the game\'s final choice.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://requiemguide.com' },
    { '@type': 'ListItem', position: 2, name: 'Story', item: 'https://requiemguide.com/story' },
    { '@type': 'ListItem', position: 3, name: 'Endings Explained', item: 'https://requiemguide.com/story/endings' },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Resident Evil Requiem Endings Explained',
  description,
  about: {
    '@type': 'VideoGame',
    name: 'Resident Evil Requiem',
  },
  mentions: [
    { '@type': 'Thing', name: 'Elpis' },
    { '@type': 'Person', name: 'Emily', url: 'https://requiemguide.com/characters/emily' },
    { '@type': 'Person', name: 'Grace Ashcroft', url: 'https://requiemguide.com/characters/grace-ashcroft' },
    { '@type': 'Person', name: 'Leon S. Kennedy', url: 'https://requiemguide.com/characters/leon-kennedy' },
    { '@type': 'Place', name: 'Rhodes Hill Care Center' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<MainLayout
  title={title}
  description={description}
  keywords={keywords}
  type="article"
  currentPath="/story/endings"
  extraSchema={[breadcrumbSchema, articleSchema, faqSchema]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb
      items={[
        { label: 'Story', href: '/story' },
        { label: 'Endings', href: '/story/endings' },
      ]}
    />

    <article class="prose-horror max-w-none" itemscope itemtype="https://schema.org/Article">
      <header class="relative mb-8 rounded-2xl overflow-hidden border border-horror-border">
        <div class="relative h-56 sm:h-72">
          <img
            loading="eager"
            width="512"
            height="286"
            src="/images/requiem_survival_guide_ending_explained_010.jpg"
            alt="Resident Evil Requiem endings explained story guide"
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-horror-bg via-horror-bg/60 to-transparent"></div>
        </div>
        <div class="p-6 sm:p-8">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-horror-red/10 text-horror-red mb-4">
            Story
          </span>
          <h1 class="text-4xl sm:text-5xl font-extrabold text-horror-text mb-4">
            Resident Evil Requiem Endings Explained
          </h1>
          <p class="text-xl text-horror-text-secondary">
            Two endings, one final choice — what releasing or destroying Elpis means for Grace, Leon, and Emily.
          </p>
        </div>
      </header>

      <!-- Quick Summary -->
      <div class="rounded-xl border border-horror-border bg-horror-surface p-5 sm:p-6 mb-8">
        <div class="flex items-center gap-2 text-horror-text font-bold text-xl mb-4">
          <Icon name="lucide:sparkles" class="w-5 h-5 text-horror-red" />
          Quick Answer
        </div>
        <p class="text-horror-text-secondary leading-relaxed mb-4">
          Resident Evil Requiem has <strong class="text-horror-text">exactly two endings</strong>, and both are decided by one final choice in the ARK:
        </p>
        <ul class="space-y-2 text-horror-text-secondary">
          <li class="flex items-start gap-3">
            <span class="w-2 h-2 rounded-full bg-horror-red mt-2 flex-shrink-0"></span>
            <span><strong class="text-horror-text">Release Elpis</strong> (password: HOPE) — the true "Hope" ending: Leon is cured, Emily is cured and adopted by Grace.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-2 h-2 rounded-full bg-horror-red mt-2 flex-shrink-0"></span>
            <span><strong class="text-horror-text">Destroy Elpis</strong> (wrong password) — the alternate "Destruction" ending: Leon dies, Emily is left in her cocoon.</span>
          </li>
        </ul>
      </div>

      <div class="bg-horror-surface border border-horror-border rounded-xl p-6 mb-8">
        <h2 class="text-2xl font-bold text-horror-text mb-4">How Endings Work</h2>
        <p class="text-horror-text-secondary mb-4">
          Nothing earlier in the game branches the ending. Emily's injury during the helicopter crash is a scripted story beat, not a consequence of your choices. The only decision that matters is the final one at the ARK central console, where you choose to release or destroy <strong class="text-horror-text">Elpis</strong> — Oswell E. Spencer's antiviral cure.
        </p>
      </div>

      <!-- All Endings -->
      <div class="space-y-6">
        <h2 class="text-2xl font-bold text-horror-text mb-4">All Resident Evil Requiem Endings</h2>

        {endings.map((ending, index) => (
          <div class="bg-horror-surface border border-horror-border rounded-xl p-6 overflow-hidden">
            <div class="flex flex-col sm:flex-row gap-6">
              <div class="sm:w-48 h-32 flex-shrink-0 rounded-lg overflow-hidden bg-horror-bg">
                <img
                  src={`/images/requiem_survival_guide_ending_explained_01${1 + index}.jpg`}
                  alt={`Resident Evil Requiem ${ending.name} ending explained`}
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="flex-1">
                <h2 class="text-2xl font-bold text-horror-text mb-2">{ending.name}</h2>
                <div class="mb-3">
                  <span class="text-sm font-semibold text-horror-red">How to unlock:</span>
                  <p class="text-horror-text-secondary">{ending.condition}</p>
                </div>
                <div>
                  <span class="text-sm font-semibold text-horror-red">Outcome:</span>
                  <p class="text-horror-text-secondary">{ending.outcome}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- How to see both -->
      <div class="mt-12 bg-horror-surface border border-horror-border rounded-xl p-6">
        <h2 class="text-2xl font-bold text-horror-text mb-4">How to See Both Endings</h2>
        <p class="text-horror-text-secondary leading-relaxed">
          Save the game before Leon takes the elevator to B4 of the Bioweapon Depot. After watching your first ending, reload that save and make the other choice — no second full playthrough needed. (The "Speed Demon" trophy asks for the release-Elpis ending in under 4 hours if you're chasing the platinum.)
        </p>
      </div>

      <!-- Internal Links -->
      <section class="mt-12">
        <h2 class="text-2xl font-bold text-horror-text mb-4">Related Story Guides</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a href="/story" class="group p-5 rounded-xl border border-horror-border bg-horror-surface/50 hover:bg-horror-surface hover:border-horror-red/50 transition-all">
            <div class="font-bold text-horror-text group-hover:text-horror-red transition-colors mb-1">Story Hub</div>
            <p class="text-xs text-horror-text-secondary">The full story of Rhodes Hill, Grace, Leon, and Emily.</p>
          </a>
          <a href="/characters/emily" class="group p-5 rounded-xl border border-horror-border bg-horror-surface/50 hover:bg-horror-surface hover:border-horror-red/50 transition-all">
            <div class="font-bold text-horror-text group-hover:text-horror-red transition-colors mb-1">Emily Guide</div>
            <p class="text-xs text-horror-text-secondary">The blind clone whose fate differs between endings.</p>
          </a>
          <a href="/characters/grace-ashcroft" class="group p-5 rounded-xl border border-horror-border bg-horror-surface/50 hover:bg-horror-surface hover:border-horror-red/50 transition-all">
            <div class="font-bold text-horror-text group-hover:text-horror-red transition-colors mb-1">Grace Ashcroft Guide</div>
            <p class="text-xs text-horror-text-secondary">FBI analyst and the game's main protagonist.</p>
          </a>
        </div>
      </section>

      <!-- FAQ -->
      <FAQSection faqs={faqs} />

      <VerificationBlock
        status="corroborated"
        sources={[
          { name: 'Game8', url: 'https://game8.co/games/Resident-Evil-Requiem/archives/582587' },
          { name: 'GameSpot', url: 'https://www.gamespot.com/gallery/resident-evil-requiem-endings-hope-destruction-elpis/2900-7533/' },
        ]}
        lastChecked="2026-09-21"
      />
    </article>
  </div>
</MainLayout>
